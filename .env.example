# Copier en .env pour l'aperçu local. Pour les builds EAS, créer ces variables avec
#   npx eas-cli@latest env:create --environment preview --visibility plaintext --name <NOM> --value <VALEUR>
# (la clé « anon » de Supabase est publique par nature : la sécurité repose sur les règles RLS).

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Render → service onile-api → URL
EXPO_PUBLIC_API_URL=https://onile-api.onrender.com
